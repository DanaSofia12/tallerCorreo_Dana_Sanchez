# Configuration variables for the Email Sending System

# SMTP Server Credentials (for real email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dsofia0528@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# Mode Configuration
# If True, no real emails will be sent. Instead, they will be printed to the console
# and saved to a file in the tallerCorreo/output/ directory.
SMTP_SIMULATION=True

# Hidden copy (BCC) for audit — used by BccDecorator in main.py
BCC_RECIPIENT=dasanchez70@unisalle.edu.co

# Default attachment and priority (AttachmentDecorator / PriorityDecorator)
EMAIL_PRIORITY=high
